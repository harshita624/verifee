# Server only. Put real secrets in server/.env or deployment secret settings.
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/<database>
# Use a unique random value of at least 32 bytes; production refuses the placeholder above.
JWT_SECRET=replace-with-a-long-random-secret
AI_PROVIDER=groq
GROQ_API_KEY=
GROQ_VISION_MODEL=qwen/qwen3.8-27b
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Marketplace routing requires PayPal partner approval and partner credentials.

PAYPAL_PARTNER_ATTRIBUTION_ID=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD

UPI_MERCHANT_VPA=
UPI_MERCHANT_NAME=Verifee
RESEND_API_KEY=
